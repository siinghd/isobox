# Binaries
/bin/
/dist/
*.exe
# Anchored to the repo root so these only ignore a root-level built binary —
# a BARE `isoboxd` also matched the cmd/isoboxd/ SOURCE dir and silently kept
# main.go out of the repo (the published tree wouldn't build).
/isobox
/isoboxd

# Go
/vendor/
*.test
*.out
coverage.*

# Runtime / local state
*.log
/data/
/run/
*.pid
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc

# local prod backups
deploy/daemon.json.bak*

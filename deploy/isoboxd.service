# isoboxd — the isobox control plane. Runs as the deploy user (must be in the
# `docker` group). Sandboxes it launches nest under isobox.slice via the
# executor's --cgroup-parent; THIS unit's own cap covers only the Go process and
# the short-lived `docker` CLI clients it spawns.
[Unit]
Description=isobox sandbox control plane
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/isobox
ExecStart=/home/deploy/isobox/bin/isoboxd
Restart=on-failure
RestartSec=2

# /var/lib/isobox (sessions, volumes, KV) — created + owned by the service user.
StateDirectory=isobox
StateDirectoryMode=0700

Environment=ISOBOX_ADDR=127.0.0.1:8090
Environment=ISOBOX_REGISTRY=/home/deploy/isobox/internal/registry/registry.yaml
Environment=ISOBOX_CONCURRENCY=4
Environment=ISOBOX_RATE_PER_MIN=30
Environment=ISOBOX_RATE_BURST=10
Environment=ISOBOX_LOG_LEVEL=info
# /execute + /v1/sessions stay open (public tenant); persistent memory/volumes
# require an API key (per-tenant isolation). Provide the key(s) via a drop-in,
# NOT here: /etc/systemd/system/isoboxd.service.d/keys.conf with
#   [Service]
#   Environment=ISOBOX_API_KEYS=<comma-separated keys>
# Set ISOBOX_REQUIRE_AUTH=1 to require a key for ALL endpoints.
Environment=ISOBOX_MEMORY_REQUIRE_KEY=1

# Control-plane footprint (NOT the sandbox ceiling — that is isobox.slice).
MemoryHigh=256M
MemoryMax=512M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
